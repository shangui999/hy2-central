#!/usr/bin/env python3
"""
Hysteria 2 用户管理 CLI (集中式)
Usage: hy2u <command> [args]
"""

import sys
import json
import subprocess
from datetime import datetime, timezone
from urllib.request import Request, urlopen
from urllib.error import URLError

API = "http://127.0.0.1:5581"
USERS_FILE = "/etc/hysteria/users.json"
NODES_FILE = "/etc/hysteria/nodes.json"


def api_call(method, path, data=None):
    url = f"{API}{path}"
    body = json.dumps(data).encode() if data else None
    req = Request(url, data=body, method=method)
    req.add_header("Content-Type", "application/json")
    try:
        with urlopen(req) as resp:
            return json.loads(resp.read())
    except URLError as e:
        if hasattr(e, "read"):
            try:
                return json.loads(e.read())
            except Exception:
                pass
        print(f"错误: 无法连接认证服务 ({e})")
        print("请确认 hy2-auth 服务正在运行: systemctl status hy2-auth")
        sys.exit(1)


def gen_password():
    result = subprocess.run(
        ["openssl", "rand", "-base64", "16"],
        capture_output=True, text=True
    ).stdout.strip()
    return result.replace("/", "").replace("+", "").replace("=", "")[:16]


def load_nodes():
    try:
        with open(NODES_FILE) as f:
            return json.load(f)
    except FileNotFoundError:
        return []


def save_nodes(nodes):
    tmp = NODES_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(nodes, f, indent=2, ensure_ascii=False)
    import os
    os.replace(tmp, NODES_FILE)


def calc_expire(spec):
    """
    spec: 0/never=永不过期, 数字=N月, 30d=N天, 6m=N月, 1y=N年, 2027-04-01=日期
    """
    from datetime import timedelta
    if spec in (0, "0", "never"):
        return None
    s = str(spec)
    now = datetime.now(timezone.utc)
    if s.endswith("d"):
        return (now + timedelta(days=int(s[:-1]))).strftime("%Y-%m-%dT%H:%M:%S")
    if s.endswith("y"):
        return (now + timedelta(days=int(s[:-1]) * 365)).strftime("%Y-%m-%dT%H:%M:%S")
    if s.endswith("m"):
        months = int(s[:-1])
    elif s.isdigit():
        months = int(s)
    else:
        return s
    month = now.month + months
    year = now.year + (month - 1) // 12
    month = (month - 1) % 12 + 1
    days_in_month = [31, 29 if year % 4 == 0 and (year % 100 != 0 or year % 400 == 0) else 28,
                     31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    day = min(now.day, days_in_month[month - 1])
    expire = now.replace(year=year, month=month, day=day)
    return expire.strftime("%Y-%m-%dT%H:%M:%S")


def print_uris(password):
    from urllib.parse import quote
    password_encoded = quote(password, safe="")
    nodes = load_nodes()
    if not nodes:
        print("  (无节点配置, 请编辑 /etc/hysteria/nodes.json)")
        return
    for n in nodes:
        ip = n["ip"]
        port = n.get("port", 9443)
        sni = n.get("sni", "bing.com")
        pin = n.get("pin", "")
        tag = n.get("tag", ip)
        mport = n.get("mport", "")
        mport_part = f"&mport={mport}" if mport else ""
        print(f"hysteria2://{password_encoded}@{ip}:{port}?sni={sni}&insecure=0&pinSHA256={pin}{mport_part}#hy2-{tag}")
        ipv6 = n.get("ipv6")
        if ipv6:
            print(f"hysteria2://{password_encoded}@[{ipv6}]:{port}?sni={sni}&insecure=0&pinSHA256={pin}{mport_part}#hy2-v6-{tag}")


def cmd_list():
    result = api_call("GET", "/users")
    users = result.get("users", [])
    if not users:
        print("暂无用户")
        return
    rows = []
    for u in users:
        expire = u.get("expire_at") or "never"
        created = u.get("created_at", "")[:19]
        status = u.get("status", "unknown")
        rows.append((u["username"], status, expire, created))
    w1 = max(max(len(r[0]) for r in rows) + 2, 10)
    fmt = f"  {{:<{w1}}} {{:<10}} {{:<24}} {{:<20}}"
    print(fmt.format("USERNAME", "STATUS", "EXPIRE", "CREATED"))
    print("  " + "-" * (w1 + 10 + 24 + 20))
    for name, status, expire, created in rows:
        print(fmt.format(name, status, expire, created))
    print(f"\n  Total: {len(rows)} users")


def cmd_add(user=None, password=None, spec="1"):
    if not user:
        user = input("用户名: ").strip()
        if not user:
            print("用户名不能为空")
            return
    if not password:
        password = gen_password()
    expire = calc_expire(spec)

    data = {"username": user, "password": password}
    if expire:
        data["expire_at"] = expire

    result = api_call("POST", "/users", data)
    if result.get("ok"):
        exp_str = f"{expire}" if expire else "永不过期"
        print(f"  ✓ 用户 {user} 创建成功")
        print(f"    密码: {password}")
        print(f"    过期: {exp_str}")
        print()
        print_uris(password)
    else:
        print(f"  ✗ 失败: {result.get('error', '未知错误')}")


def cmd_del(user=None):
    if not user:
        user = input("要删除的用户名: ").strip()
    result = api_call("DELETE", f"/users/{user}")
    if result.get("ok"):
        print(f"  ✓ 用户 {user} 已删除")
    else:
        print(f"  ✗ 失败: {result.get('error', '未知错误')}")


def cmd_renew(user=None, spec="1"):
    if not user:
        user = input("用户名: ").strip()
    expire = calc_expire(spec)
    result = api_call("PUT", f"/users/{user}", {"expire_at": expire})
    if result.get("ok"):
        if expire:
            print(f"  ✓ 用户 {user} 新过期时间: {expire}")
        else:
            print(f"  ✓ 用户 {user} 已设为永不过期")
    else:
        err = result.get("error", "未知错误")
        print(f"  ✗ 失败: {err}")

def cmd_passwd(user=None, password=None):
    if not user:
        user = input("用户名: ").strip()
    if not password:
        password = gen_password()
    result = api_call("PUT", f"/users/{user}", {"password": password})
    if result.get("ok"):
        print(f"  ✓ 密码已更新: {user}")
        print(f"    新密码: {password}")
        print()
        print_uris(password)
    else:
        print(f"  ✗ 失败: {result.get('error', '未知错误')}")


def cmd_uri(user=None):
    if not user:
        user = input("用户名: ").strip()
    try:
        with open(USERS_FILE) as f:
            users = json.load(f)
    except FileNotFoundError:
        print("错误: users.json 不存在")
        return
    if user not in users:
        print(f"  用户 {user} 不存在")
        return
    print_uris(users[user]["password"])


def cmd_nodes():
    nodes = load_nodes()
    if not nodes:
        print("  暂无节点, 请编辑 /etc/hysteria/nodes.json")
        return
    fmt = "  {:<18} {:<22} {:<6}"
    print(fmt.format("TAG", "IP", "PORT"))
    print("  " + "-" * 46)
    for n in nodes:
        print(fmt.format(n.get("tag", ""), n["ip"], n.get("port", 9443)))


def cmd_add_node(args):
    tag = ip = ipv6 = pin = mport = sni = None
    port = 9443
    i = 0
    while i < len(args):
        if args[i] == "--tag" and i + 1 < len(args):
            tag = args[i + 1]; i += 2
        elif args[i] == "--ip" and i + 1 < len(args):
            ip = args[i + 1]; i += 2
        elif args[i] == "--ipv6" and i + 1 < len(args):
            ipv6 = args[i + 1]; i += 2
        elif args[i] == "--port" and i + 1 < len(args):
            port = int(args[i + 1]); i += 2
        elif args[i] == "--pin" and i + 1 < len(args):
            pin = args[i + 1]; i += 2
        elif args[i] == "--mport" and i + 1 < len(args):
            mport = args[i + 1]; i += 2
        elif args[i] == "--sni" and i + 1 < len(args):
            sni = args[i + 1]; i += 2
        else:
            print(f"  未知参数: {args[i]}")
            return
    if not tag or not ip or not pin:
        print("用法: hy2u add-node --tag <tag> --ip <ip> --pin <sha256> [--ipv6 <v6>] [--port 9443] [--mport 50000-60000] [--sni bing.com]")
        return

    node = {"tag": tag, "ip": ip, "port": port, "sni": sni or "bing.com", "pin": pin}
    if ipv6:
        node["ipv6"] = ipv6
    if mport:
        node["mport"] = mport

    nodes = load_nodes()
    for n in nodes:
        if n.get("tag") == tag:
            print(f"  ✗ 节点 {tag} 已存在")
            return
    nodes.append(node)
    save_nodes(nodes)
    print(f"  ✓ 节点已注册: {tag} ({ip}:{port})")


def cmd_del_node(tag=None):
    if not tag:
        tag = input("节点 tag: ").strip()
    nodes = load_nodes()
    new_nodes = [n for n in nodes if n.get("tag") != tag]
    if len(new_nodes) == len(nodes):
        print(f"  ✗ 节点 {tag} 不存在")
        return
    save_nodes(new_nodes)
    print(f"  ✓ 节点 {tag} 已删除")


def cmd_help():
    import unicodedata
    def wlen(s):
        """计算字符串的显示宽度 (中文占2列)"""
        w = 0
        for c in s:
            if unicodedata.east_asian_width(c) in ('F', 'W'):
                w += 2
            else:
                w += 1
        return w

    def fmt(left, right, width=40):
        pad = width - wlen(left)
        if pad < 1:
            pad = 1
        return f"  {left}{' ' * pad}{right}"

    lines = [
        "hy2u - Hysteria 2 用户管理 (集中式)",
        "",
        "用法: hy2u <命令> [参数]",
        "",
        "用户管理:",
    ]
    cmds = [
        ("list",                            "查看所有用户"),
        ("add  [用户] [密码] [时长|日期]",  "添加用户 (密码空=随机, 默认1月)"),
        ("del  [用户]",                     "删除用户"),
        ("renew [用户] [时长|日期]",        "续期"),
        ("passwd [用户] [新密码]",          "改密码 (省略=随机)"),
        ("uri  [用户]",                     "生成所有节点的客户端 URI"),
    ]
    for l, r in cmds:
        lines.append(fmt(l, r))

    lines += ["", "节点管理:"]
    nodes = [
        ("nodes",           "查看节点列表"),
        ("add-node <选项>", "注册节点"),
        ("del-node [tag]",  "删除节点"),
    ]
    for l, r in nodes:
        lines.append(fmt(l, r))

    lines += ["", "时长格式:"]
    durs = [
        ("30d",        "30 天后过期"),
        ("6m 或 6",    "6 个月后过期"),
        ("1y",         "1 年后过期"),
        ("2027-04-01", "指定到期日期"),
        ("never 或 0", "永不过期"),
    ]
    for l, r in durs:
        lines.append(fmt(l, r, 18))

    lines += ["", "示例:"]
    examples = [
        ('hy2u add alice "" 3',      "添加用户, 随机密码, 3个月"),
        ("hy2u add bob mypass 300d", "添加用户, 指定密码, 300天"),
        ('hy2u add carol "" never',  "添加用户, 永不过期"),
        ("hy2u del alice",           "删除用户"),
        ("hy2u renew bob 6m",       "续期 6 个月"),
        ("hy2u renew bob 2027-04-01","续期到指定日期"),
        ("hy2u renew bob never",    "改为永不过期"),
        ("hy2u passwd bob",         "随机新密码"),
        ("hy2u uri bob",            "输出所有节点 URI"),
        ("", ""),
        ("hy2u nodes",              "查看节点列表"),
        ("hy2u add-node --tag t ...", "注册节点 (--ip/--pin/--mport)"),
        ("hy2u del-node jp-tok",    "删除节点"),
    ]
    for l, r in examples:
        if l == "":
            lines.append("")
        else:
            lines.append(fmt(l, r))

    print("\n".join(lines))

def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "help"

    if cmd in ("list", "ls", "l"):
        cmd_list()
    elif cmd in ("add", "a"):
        user = args[1] if len(args) > 1 else None
        password = args[2] if len(args) > 2 and args[2] else None
        spec = args[3] if len(args) > 3 else "1"
        cmd_add(user, password, spec)
    elif cmd in ("del", "rm", "d"):
        cmd_del(args[1] if len(args) > 1 else None)
    elif cmd in ("renew", "r"):
        user = args[1] if len(args) > 1 else None
        spec = args[2] if len(args) > 2 else "1"
        cmd_renew(user, spec)
    elif cmd in ("passwd", "pw", "p"):
        user = args[1] if len(args) > 1 else None
        password = args[2] if len(args) > 2 else None
        cmd_passwd(user, password)
    elif cmd in ("uri", "u"):
        cmd_uri(args[1] if len(args) > 1 else None)
    elif cmd in ("nodes", "n"):
        cmd_nodes()
    elif cmd == "add-node":
        cmd_add_node(args[1:])
    elif cmd in ("del-node", "rm-node"):
        cmd_del_node(args[1] if len(args) > 1 else None)
    else:
        cmd_help()


if __name__ == "__main__":
    main()
